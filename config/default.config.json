{
  "models": {
    "local_fast": {
      "primary": {
        "provider": "ollama",
        "model": "llama3.2:latest",
        "baseUrl": "http://localhost:11434/v1",
        "timeoutMs": 120000
      }
    },
    "local_strong": {
      "primary": {
        "provider": "litellm",
        "model": "glm",
        "baseUrl": "http://localhost:4000/v1",
        "apiKey": "${LITELLM_MASTER_KEY:-sk-litellm-local}",
        "timeoutMs": 300000
      },
      "fallback": {
        "provider": "ollama",
        "model": "qwen3:8b",
        "baseUrl": "http://localhost:11434/v1",
        "timeoutMs": 300000
      }
    },
    "hosted_oss": {
      "primary": {
        "provider": "litellm",
        "model": "qwen3-coder-next",
        "baseUrl": "http://localhost:4000/v1",
        "apiKey": "${LITELLM_MASTER_KEY:-sk-litellm-local}",
        "timeoutMs": 300000
      },
      "fallback": {
        "provider": "ollama",
        "model": "qwen3:8b",
        "baseUrl": "http://localhost:11434/v1",
        "timeoutMs": 300000
      }
    },
    "premium": {
      "primary": {
        "provider": "litellm",
        "model": "bedrock/global.anthropic.claude-sonnet-4-6",
        "baseUrl": "http://localhost:4000/v1",
        "apiKey": "${LITELLM_MASTER_KEY:-sk-litellm-local}",
        "timeoutMs": 600000
      }
    }
  },
  "routing": {
    "defaultTier": "local_strong",
    "defaultMode": "balanced",
    "maxRetriesPerTier": 1,
    "enableEscalation": true,
    "preferLocal": true,
    "longContextTokenThreshold": 32000,
    "probeAvailability": true,
    "probeCacheTtlMs": 30000,
    "probeOnDryRun": false,
    "learnedRoutingHints": true,
    "learnedMinSamples": 5
  },
  "telemetry": {
    "enabled": true,
    "logPath": "${MAESTRO_TELEMETRY_PATH:-~/.maestro-ai/telemetry.jsonl}"
  },
  "premiumPool": [
    {
      "provider": "litellm",
      "model": "bedrock/global.anthropic.claude-sonnet-4-6",
      "baseUrl": "http://localhost:4000/v1",
      "apiKey": "${LITELLM_MASTER_KEY:-sk-litellm-local}",
      "timeoutMs": 600000
    }
  ]
}
