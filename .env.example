# Maestro AI — copy to ~/.maestro-ai/.env or export in your shell / MCP config.
# LiteLLM proxy (required for full/default profile)
LITELLM_MASTER_KEY=sk-litellm-local

# Featherless API (hosted_oss + local_strong primary in default profile)
FEATHERLESS_API_KEY=

# AWS Bedrock (premium tier in default/cloud profile — optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION_NAME=us-east-1

# Maestro config (set automatically by `maestro init`)
MAESTRO_CONFIG=~/.maestro-ai/config.json
MAESTRO_TELEMETRY_PATH=~/.maestro-ai/telemetry.jsonl
